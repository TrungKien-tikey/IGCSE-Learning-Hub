# Copy this file to .env and fill in the values.
# Keep the format KEY=VALUE (no export, no quotes, comments on their own lines).

# JWT (required, no default). Generate with:
#   openssl rand -base64 48
# Must be identical for auth, user, course, exam, ai, communication services.
JWT_SECRET=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Mail (Gmail app password)
MAIL_USERNAME=
MAIL_PASSWORD=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# OpenAI
OPENAI_API_KEY=

# Firebase (relative to communication-service working dir)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
